{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.theitaliangateway.com"
        }
      ],
      "destination": "https://theitaliangateway.com/$1",
      "permanent": true
    }
  ]
}
